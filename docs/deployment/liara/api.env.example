# ── برنامه‌ی arkan-api در لیارا (api.arkan.gold) ──────────────────────
APP_SERVICE=api
NODE_ENV=production
PORT=3000

# PostgreSQL لیارا — از بخش «اطلاعات اتصال» دیتابیس (آدرس شبکه‌ی خصوصی) کپی کنید
DATABASE_URL=postgresql://USER:PASSWORD@DB-ID:5432/DBNAME

# Redis لیارا (هاست = شناسه‌ی دیتابیس در شبکه‌ی خصوصی)
REDIS_HOST=REDIS-ID
REDIS_PORT=6379
REDIS_PASSWORD=

# هر کدام یک کلید مستقل و حداقل ۳۲ بایتی:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_TEMP_SECRET=
JWT_RESET_SECRET=
JWT_ADMIN_SECRET=
JWT_ADMIN_REFRESH_SECRET=

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# ذخیره‌سازی ابری لیارا (Object Storage) — رسید واریز و پیوست تیکت
S3_ENDPOINT=https://storage.iran.liara.space
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

NEXT_PUBLIC_APP_URL=https://app.arkan.gold
PRISMA_MIGRATE_ON_START=true
LOG_LEVEL=info

# راز مشترک با app و admin (هر سه برنامه دقیقاً همین مقدار): با آن API، IP و User-Agent واقعی
# کاربر را از درخواست‌های سرور Next.js می‌پذیرد تا rate limit برای هر کاربر جدا حساب شود.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
INTERNAL_PROXY_SECRET=

# پراکسی‌های مورد اعتماد برای خواندن IP کاربر از X-Forwarded-For (پیش‌فرض: شبکه‌ی داخلی پلتفرم).
# فقط اگر پشت CDN (مثل Cloudflare/آروان) هستید رنج‌های آن را اضافه کنید.
# TRUST_PROXY=loopback, linklocal, uniquelocal, 100.64.0.0/10
