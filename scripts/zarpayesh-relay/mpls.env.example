# scripts/zarpayesh-relay/mpls.env.example
#
# تنظیمات «روتر پلتفرم» روی خود سرور اوبونتو برای اتصال به بستر MPLS جدید شاپرک (پروژه‌ی طلا / زر پایش):
#   لینک خام MPLS  →  دو تانل GRE over IPsec  →  OSPF  →  NAT Pool اختصاصی
# کپی به mpls.env و با «فایل تنظیمات اختصاصی پلتفرم» شاپرک تکمیل کنید. هر خط فقط نام=مقدار (بدون توضیح در همان خط).
# PSK را این‌جا ننویسید؛ setup-mpls-router.sh آن را جداگانه می‌پرسد و در /etc/zarpayesh-mpls/psk نگه می‌دارد.

# ── Underlay: لینک خام MPLS مخابرات ──
# کارت شبکه‌ای که لینک MPLS روی آن تحویل شده
MPLS_IFACE=enp5s0f1
# IP و ماسک سمت پلتفرم روی MPLS (PLATFORM-MPLS-IP) — همان tunnel source
MPLS_IP_CIDR=
# Gateway روتر مخابرات روی لینک MPLS
MPLS_GATEWAY=

# ── مقصدهای شاپرک (ثابت در سند شاپرک) ──
SHAPARAK_MAIN=172.21.193.2
SHAPARAK_BACKUP=172.21.194.2

# ── تانل‌ها: IP سمت پلتفرم با ماسک /30 (PLATFORM-TUNNEL-IP) ──
# Tunnel X — مسیر اصلی
TUN_MAIN_IP_CIDR=
# Tunnel Y — مسیر پشتیبان
TUN_BACKUP_IP_CIDR=
TUNNEL_MTU=1400

# ── OSPF (Process ID محلی است؛ در FRR لازم نیست) ──
OSPF_ROUTER_ID=
# شماره یا قالب نقطه‌دار، مثلاً 240 یا 0.0.0.240
OSPF_AREA=
# normal یا nssa — طبق فایل اختصاصی
OSPF_AREA_TYPE=normal
# هزینه‌ی مسیر اصلی باید کمتر از پشتیبان باشد (MAIN-COST)
OSPF_COST_MAIN=10
OSPF_COST_BACKUP=100

# ── NAT Pool اختصاصی (/29) ──
NAT_POOL_CIDR=
# یکی از آدرس‌های همان Pool؛ همه‌ی درخواست‌های سرور با این آدرس به زر پایش می‌رسند
NAT_SOURCE_IP=

# ── شبکه‌ی سرویس‌های شاپرک (از OSPF آموخته می‌شود) ──
SERVICE_NET=172.20.248.0/24

# ── IPsec/IKEv1 — فقط با هماهنگی شاپرک تغییر دهید ──
# معادل: encryption aes 128 / hash sha / group 5
IKE_PROPOSAL=aes128-sha1-modp1536
# معادل: transform-set esp-aes esp-sha-hmac (بدون PFS)
ESP_PROPOSAL=aes128-sha1
# معادل: mode tunnel
IPSEC_MODE=tunnel
