# ── برنامه‌ی arkan-api در لیارا (api.arkan.gold) ──────────────────────
APP_SERVICE=api
NODE_ENV=production
PORT=3000

# PostgreSQL لیارا — از بخش «اطلاعات اتصال» دیتابیس (آدرس شبکه‌ی خصوصی) کپی کنید
DATABASE_URL=postgresql://USER:PASSWORD@DB-ID:5432/DBNAME

# Redis لیارا (هاست = شناسه‌ی دیتابیس در شبکه‌ی خصوصی)
REDIS_HOST=REDIS-ID
REDIS_PORT=6379
REDIS_PASSWORD=

# هر کدام یک کلید مستقل و حداقل ۳۲ بایتی:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_TEMP_SECRET=
JWT_RESET_SECRET=
JWT_ADMIN_SECRET=
JWT_ADMIN_REFRESH_SECRET=

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# ذخیره‌سازی ابری لیارا (Object Storage) — رسید واریز و پیوست تیکت
S3_ENDPOINT=https://storage.iran.liara.space
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

NEXT_PUBLIC_APP_URL=https://app.arkan.gold
# آدرس عمومی همین API — برای ساخت آدرس مطلق تصاویر در API عمومی شمش (/public/gold-ingots)
PUBLIC_API_URL=https://api.arkan.gold
PRISMA_MIGRATE_ON_START=true
LOG_LEVEL=info

# راز مشترک با app و admin (هر سه برنامه دقیقاً همین مقدار): با آن API، IP و User-Agent واقعی
# کاربر را از درخواست‌های سرور Next.js می‌پذیرد تا rate limit برای هر کاربر جدا حساب شود.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
INTERNAL_PROXY_SECRET=

# پراکسی‌های مورد اعتماد برای خواندن IP کاربر از X-Forwarded-For (پیش‌فرض: شبکه‌ی داخلی پلتفرم).
# TRUST_PROXY=loopback, linklocal, uniquelocal, 100.64.0.0/10

# پشت CDN آروان: رنج‌های IP آروان (https://www.arvancloud.ir/fa/ips.txt) با کاما یا فاصله، در هر سه برنامه
# (api، app، admin) با یک مقدار. به فهرست TRUST_PROXY اضافه می‌شود. بدون آن IP سرور لبه‌ی آروان به‌جای IP
# کاربر شمرده می‌شود و کاربران زیادی با هم rate limit / قفل می‌خورند. فهرست آروان را هر چند ماه به‌روز کنید.
# فهرست آروان در تاریخ ۱۴۰۵/۰۷/۰۶ (۲۰۲۶-۰۹-۲۸):
CDN_PROXY_RANGES=185.143.232.0/22,188.229.116.16/30,94.101.182.0/27,2.144.3.128/28,37.32.16.0/27,37.32.17.0/27,37.32.18.0/27,37.32.19.0/27,185.215.232.0/22,178.131.120.48/28,94.101.183.0/28,78.157.36.112/28,95.38.61.80/28,193.24.119.0/29

# فقط تا وقتی سرویس پیامک واقعی وصل نشده: کد OTP در لاگ برنامه (سطح warn) چاپ می‌شود.
# در production هر دو متغیر لازم است. بعد از اتصال پیامک حتماً حذف کنید.
# OTP_DEBUG_LOG=true
# OTP_DEBUG_LOG_ALLOW_PRODUCTION=true

# ── مرکز پیامک (قاصدک / sms.ir) ──
# کلید API و شماره خط از پنل ادمین ← «مرکز پیامک» ثبت و سامانه همان‌جا فعال می‌شود.
# ارسال واقعی فقط وقتی NODE_ENV=production باشد انجام می‌شود؛ در محیط‌های دیگر فقط «ارسال آزمایشی» در لاگ ثبت می‌شود.
# کلید اضطراری قطع ارسال واقعی در production: SMS_LIVE_SEND=false
# ارسال واقعی در محیط تست (فقط آزمایش کنترل‌شده): SMS_LIVE_SEND=true
# SMS_LIVE_SEND=
