# فایل‌هایی که `liara deploy` آپلود نمی‌کند (جایگزین .gitignore ریشه برای CLI لیارا).
# وابستگی‌ها و خروجی build روی سرور لیارا ساخته می‌شوند.
node_modules
.pnpm-store
dist
.next
out
coverage
*.tsbuildinfo
next-env.d.ts
api/src/generated/prisma

# اسرار — از «متغیرهای محیطی» برنامه در پنل استفاده کنید
.env
.env.*
*.pem

# فایل‌های آپلودی کاربران روی دیسک لیارا (mount در api/uploads) نگه داشته می‌شوند
# و نباید با هر استقرار بازنویسی شوند
api/uploads

# موارد غیرضروری برای اجرا
/docs
.git
.vscode
.idea
*.log
.DS_Store

# فایل‌های پیکربندی چابکان
.chabokignore

# لیارا با دیدن pnpm-lock.yaml در ریشه، خودش pnpm را با yarn نصب و اجرا می‌کند و با فیلد
# packageManager شکست می‌خورد؛ کپی آن (scripts/deploy/pnpm-lock.deploy.yaml) آپلود و در build
# توسط scripts/deploy/run.mjs سر جایش گذاشته می‌شود
/pnpm-lock.yaml
