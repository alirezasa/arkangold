# ─────────────────────────────────────────────────────────────
# متغیرهای محیطی سرویس admin.arkan.gold در چابکان
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# آدرسی که route handlerهای سمت سرور Next.js با آن به API وصل می‌شوند.
# اگر سرویس‌ها در یک شبکه‌ی داخلی چابکان هستند، آدرس داخلی API را بدهید (سریع‌تر، بدون عبور از اینترنت)؛
# در غیر این صورت: https://api.arkan.gold
NEST_API_URL=https://api.arkan.gold

# توجه: NEXT_PUBLIC_NEST_ORIGIN (آدرس API در کد مرورگر) هنگام «بیلد» جاسازی می‌شود و
# پیش‌فرض آن در Dockerfile برابر https://api.arkan.gold است؛ تغییر آن فقط با build-arg ممکن است.
