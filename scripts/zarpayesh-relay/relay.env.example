# scripts/zarpayesh-relay/relay.env.example — تنظیمات سرور رله (کپی به relay.env و تکمیل)

# نام دامنه‌ی رله (رکورد A به IP عمومی سرور، در آروان «بدون پروکسی/ابر خاموش»)
RELAY_NAME=zp-relay.arkan.gold
# پورت HTTPS رله
RELAY_PORT=8443
# کلید مشترک با سرویس api (همان ZARPAYESH_RELAY_SECRET رانفلر) — فقط hex:
#   openssl rand -hex 32
RELAY_SECRET=

# ── مقصد داخل لینک MPLS (از زر پایش/اپراتور بگیرید) ──
# http یا https — همانی که زر پایش روی MPLS ارائه می‌دهد
ZP_UPSTREAM_SCHEME=https
# IP:پورت سرور زر پایش داخل MPLS
ZP_UPSTREAM_ADDR=10.0.0.10:443
# نام میزبانی که زر پایش انتظار دارد (هدر Host و SNI)
ZP_UPSTREAM_HOST=api.rpmms.ir
# بررسی گواهی سرور زر پایش (فقط برای https). اگر گواهی آن‌ها داخلی/خودامضاست off بگذارید
ZP_UPSTREAM_VERIFY=on

# ── فایروال (ufw) ──
# IPهای مجاز به پورت رله، با فاصله (مثلاً IP خروجی رانفلر). خالی = همه (حفاظت با mTLS و کلید)
RELAY_ALLOW_FROM=
# IPهای مجاز به SSH، با فاصله. خالی = همه (فقط با کلید SSH)
SSH_ALLOW_FROM=
# پورت SSH
SSH_PORT=22
