  admin      User?    @relation("AdminAudit", fields: [adminId], references: [id])
  user       User?    @relation("UserAudit", fields: [userId], references: [id])

  @@index([userId])
  @@index([adminId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemConfig {
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  id          String   @id @default(uuid()) @db.Uuid

  @@map("system_configs")
}

model VaultGoldInventory {
  type        VaultInventoryType
  amountGrams Decimal            @map("amount_grams") @db.Decimal(18, 4)
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  id          String             @id @default(uuid()) @db.Uuid
  referenceId String?            @map("reference_id") @db.Uuid

  @@map("vault_gold_inventory")
}

model SettlementLog {
  bankTransactionId String           @unique @map("bank_transaction_id")
  amountRial        Decimal          @map("amount_rial") @db.Decimal(18, 0)
  status            SettlementStatus @default(PENDING)
  settledAt         DateTime?        @map("settled_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  id                String           @id @default(uuid()) @db.Uuid
  userId            String?          @map("user_id") @db.Uuid
  user              User?            @relation(fields: [userId], references: [id])

  @@map("settlement_logs")
}

model Notification {
  type      NotificationType
  content   String
  sentAt    DateTime?        @map("sent_at")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AdminUser {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique
  passwordHash String  @map("password_hash")
  fullName     String  @map("full_name")
  isActive     Boolean @default(true) @map("is_active")

  totpSecret      String?   @map("totp_secret")
  totpEnabled     Boolean   @default(false) @map("totp_enabled")
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  backupCodesHash String[]  @default([]) @map("backup_codes_hash")

  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  lastLoginIp      String?   @map("last_login_ip")

  roleId String    @map("role_id") @db.Uuid
  role   AdminRole @relation(fields: [roleId], references: [id])

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  createdById   String?     @map("created_by_id") @db.Uuid
  createdBy     AdminUser?  @relation("AdminCreatedBy", fields: [createdById], references: [id])
  createdAdmins AdminUser[] @relation("AdminCreatedBy")

  sessions        AdminSession[]
  auditLogs       AdminAuditLog[]
  assignedTickets Ticket[]        @relation("TicketAssignedAdmin")

  @@map("admin_users")
}

model AdminRole {
  id          String                @id @default(uuid()) @db.Uuid
  key         String                @unique
  name        String
  description String?
  isSystem    Boolean               @default(false) @map("is_system")
  permissions AdminRolePermission[]
  users       AdminUser[]
  createdAt   DateTime              @default(now()) @map("created_at")

  @@map("admin_roles")
}

model AdminPermission {
  id          String                @id @default(uuid()) @db.Uuid
  key         String                @unique
  group       String
  description String?
  roles       AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminUserId      String    @map("admin_user_id") @db.Uuid
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  oldValue    Json?     @map("old_value")
  newValue    Json?     @map("new_value")
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
//  آرکان گلد — افزوده‌های فاکتور / پیش‌فاکتور / واریز
//  محتوای زیر را به انتهای api/prisma/schema.prisma اضافه کنید و بلوک
//  «تغییرات مدل‌های موجود» را در جای خودش اعمال کنید. سپس:
//    pnpm prisma migrate dev --name invoice_and_deposit
// ═══════════════════════════════════════════════════════════════════════════

/// شمارنده اسناد — شماره‌گذاری اتمیک. هرگز از count()+1 استفاده نکنید.
model DocumentSequence {
  key        String   @id // "INV:1404" | "PRF:1404" | "DEP:1404"
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("document_sequences")
}

/// سند مالی — فاکتور فروش یا پیش‌فاکتور واریز.
/// پس از ISSUED غیرقابل ویرایش؛ اصلاح فقط با ابطال + صدور سند جدید.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  kind          InvoiceKind
  invoiceNumber String        @unique @map("invoice_number") // AG-1404-INV-000123
  status        InvoiceStatus @default(ISSUED)

  sourceType InvoiceSource @map("source_type")
  sourceId   String        @map("source_id") @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// Snapshot اطلاعات شرکت در لحظه صدور (از SystemConfig)
  companySnapshot  Json  @map("company_snapshot")
  /// Snapshot اطلاعات مشتری در لحظه صدور
  customerSnapshot Json  @map("customer_snapshot")
  /// داده اختصاصی سند — برای PROFORMA: حساب مقصد، شناسه واریز، بندهای حقوقی
  extraData        Json? @map("extra_data")

  subtotalRial Decimal @map("subtotal_rial") @db.Decimal(18, 0)
  discountRial Decimal @default(0) @map("discount_rial") @db.Decimal(18, 0)
  feeRial      Decimal @default(0) @map("fee_rial") @db.Decimal(18, 0)
  taxRial      Decimal @default(0) @map("tax_rial") @db.Decimal(18, 0)
  totalRial    Decimal @map("total_rial") @db.Decimal(18, 0)
  totalInWords String  @map("total_in_words")

  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime? @map("expires_at") // فقط PROFORMA
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  /// sha256 از payload کانونیکال — ضدجعل و پیش‌نیاز امضای دیجیتال
  contentHash String @map("content_hash")

  // ── فازهای بعدی (nullable، فعلاً بلااستفاده) ──
  pdfStorageKey    String?   @map("pdf_storage_key")
  signedAt         DateTime? @map("signed_at")
  signaturePayload String?   @map("signature_payload")
  taxAuthorityRef  String?   @map("tax_authority_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items          InvoiceItem[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositRequest DepositRequest?

  /// ضدتکرار: حداکثر یک سند از هر نوع به ازای هر منبع
  @@unique([sourceType, sourceId, kind])
  @@index([userId, kind, issuedAt])
  @@index([status, issuedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  rowNo       Int     @map("row_no")
  productCode String? @map("product_code")
  title       String
  unit        String // گرم | عدد
  purityKarat String? @map("purity_karat") // K18 | K24

  quantity      Decimal  @db.Decimal(18, 4)
  weightGrams   Decimal? @map("weight_grams") @db.Decimal(18, 4)
  unitPriceRial Decimal  @map("unit_price_rial") @db.Decimal(18, 0)
  discountRial  Decimal  @default(0) @map("discount_rial") @db.Decimal(18, 0)
  makingRial    Decimal  @default(0) @map("making_rial") @db.Decimal(18, 0) // اجرت ساخت
  feeRial       Decimal  @default(0) @map("fee_rial") @db.Decimal(18, 0) // کارمزد
  taxRate       Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxRial       Decimal  @default(0) @map("tax_rial") @db.Decimal(18, 0)
  totalRial     Decimal  @map("total_rial") @db.Decimal(18, 0)

  /// breakdown خام قفل‌شده محصول — برای رهگیری و ممیزی
  meta Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, rowNo])
  @@map("invoice_items")
}

/// درخواست واریز تومان — جایگزین کدگذاری رشته‌ای در Transaction.description
model DepositRequest {
  id            String        @id @default(uuid()) @db.Uuid
  requestNumber String        @unique @map("request_number") // AG-1404-DEP-000123
  userId        String        @map("user_id") @db.Uuid
  walletId      String        @map("wallet_id") @db.Uuid
  amountRial    Decimal       @map("amount_rial") @db.Decimal(18, 0)
  method        DepositMethod
  status        DepositStatus @default(PENDING_PAYMENT)

  /// شناسه واریز اختصاصی — عددی ۱۶ رقمی با رقم کنترل Luhn
  depositTrackingId String @unique @map("deposit_tracking_id")

  /// Snapshot حساب مقصد در لحظه صدور
  destinationSnapshot Json @map("destination_snapshot")

  proformaInvoiceId String? @unique @map("proforma_invoice_id") @db.Uuid
  /// ضدشارژ مضاعف در سطح دیتابیس — آخرین خط دفاع
  transactionId     String? @unique @map("transaction_id") @db.Uuid
  idempotencyKey    String? @unique @map("idempotency_key")

  expiresAt       DateTime  @map("expires_at")
  reviewStartedAt DateTime? @map("review_started_at")
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid // → admin_users.id (بدون FK عمدی)
  reviewedAt      DateTime? @map("reviewed_at")
  rejectionReason String?   @map("rejection_reason")
  rejectionCount  Int       @default(0) @map("rejection_count")
  adminNotes      String?   @map("admin_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  receipts        DepositReceipt[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  proformaInvoice Invoice?         @relation(fields: [proformaInvoiceId], references: [id])
  transaction     Transaction?     @relation(fields: [transactionId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("deposit_requests")
}

/// رسید واریز آپلودشده توسط کاربر — فایل در S3 خصوصی
model DepositReceipt {
  id               String   @id @default(uuid()) @db.Uuid
  depositRequestId String   @map("deposit_request_id") @db.Uuid
  storageKey       String   @map("storage_key") // کلید S3 — هرگز URL عمومی
  bucket           String
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  fileSize         Int      @map("file_size")
  /// تشخیص رسید تکراری در کل سیستم — سیگنال ضدتقلب
  checksumSha256   String   @map("checksum_sha256")
  userNote         String?  @map("user_note")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  depositRequest DepositRequest @relation(fields: [depositRequestId], references: [id], onDelete: Cascade)

  @@index([depositRequestId])
  @@index([checksumSha256])
  @@map("deposit_receipts")
}

model IntegrationProvider {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique // FINOTECH, MOCK, COMPANY_X ...
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services    IntegrationProviderService[]
  credentials IntegrationProviderCredential[]
  logs        IntegrationLog[]

  @@map("integration_providers")
}

model IntegrationService {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique // IDENTITY_VERIFICATION, SMS, GOLD_PRICE ...
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  providers IntegrationProviderService[]
  logs      IntegrationLog[]

  @@map("integration_services")
}

model IntegrationProviderService {
  id            String   @id @default(uuid()) @db.Uuid
  providerId    String   @map("provider_id") @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  priority      Int      @default(1) // عدد کوچک‌تر = اولویت بالاتر (Primary)
  isFallback    Boolean  @default(false) @map("is_fallback")
  configuration Json? // timeout, retry, endpoint override و ...
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  provider IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  IntegrationService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@index([serviceId, isActive, priority])
  @@map("integration_provider_services")
}

model IntegrationProviderCredential {
  id             String   @id @default(uuid()) @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  key            String // CLIENT_ID, CLIENT_SECRET, API_KEY, NID ...
  encryptedValue String   @map("encrypted_value") // فرمت: iv:authTag:cipherText (Base64، هر بخش با : جدا شده)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  provider IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, key])
  @@map("integration_provider_credentials")
}

model IntegrationLog {
  id                String   @id @default(uuid()) @db.Uuid
  requestId         String   @map("request_id")
  providerId        String?  @map("provider_id") @db.Uuid
  serviceId         String?  @map("service_id") @db.Uuid
  status            String // SUCCESS | FAILED
  httpStatus        Int?     @map("http_status")
  providerRequestId String?  @map("provider_request_id")
  errorCode         String?  @map("error_code")
  durationMs        Int?     @map("duration_ms")
  createdAt         DateTime @default(now()) @map("created_at")

  provider IntegrationProvider? @relation(fields: [providerId], references: [id])
  service  IntegrationService?  @relation(fields: [serviceId], references: [id])

  @@index([requestId])
  @@index([providerId, createdAt])
  @@index([serviceId, createdAt])
  @@map("integration_logs")
}

model TicketCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tickets Ticket[]

  @@index([isActive])
  @@map("ticket_categories")
}

model Ticket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  userId          String         @db.Uuid
  categoryId      String
  subject         String
  description     String         @db.Text
  priority        TicketPriority @default(NORMAL)
  status          TicketStatus   @default(OPEN)
  assignedAdminId String?        @db.Uuid

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  lastMessageAt   DateTime  @default(now())
  closedBy        String?
  closedReason    String?

  deletedAt DateTime?
  deletedBy String?

  user          User           @relation(fields: [userId], references: [id])
  category      TicketCategory @relation(fields: [categoryId], references: [id])
  assignedAdmin AdminUser?     @relation("TicketAssignedAdmin", fields: [assignedAdminId], references: [id])

  messages     TicketMessage[]
  attachments  TicketAttachment[]
  assignments  TicketAssignment[]
  statusLogs   TicketStatusHistory[]
  activityLogs TicketActivityLog[]
  rating       TicketRating?

  @@index([userId])
  @@index([status])
  @@index([categoryId])
  @@index([assignedAdminId])
  @@index([createdAt])
  @@index([userId, status])
  @@map("tickets")
}

model TicketMessage {
  id         String  @id @default(cuid())
  ticketId   String
  userId     String? @db.Uuid
  adminId    String? @db.Uuid
  senderType TicketSenderType
  message    String  @db.Text
  isInternal Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  ticket      Ticket             @relation(fields: [ticketId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([ticketId, isInternal])
  @@map("ticket_messages")
}


model TicketAttachment {
  id               String   @id @default(cuid())
  ticketId         String
  messageId        String?
  userId           String   @db.Uuid
  originalFilename String
  storageKey       String   @unique
  mimeType         String
  fileSize         Int
  extension        String
  createdAt        DateTime @default(now())
  deletedAt        DateTime?
  deletedBy        String?

  ticket  Ticket         @relation(fields: [ticketId], references: [id])
  message TicketMessage? @relation(fields: [messageId], references: [id])

  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_attachments")
}


model TicketAssignment {
  id               String   @id @default(cuid())
  ticketId         String
  assignedAdminId  String   @db.Uuid
  assignedBy       String
  assignmentReason String?
  createdAt        DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("ticket_assignments")
}


model TicketStatusHistory {
  id            String           @id @default(cuid())
  ticketId      String
  oldStatus     TicketStatus?
  newStatus     TicketStatus
  changedBy     String
  changedByType TicketSenderType
  reason        String?
  createdAt     DateTime         @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("ticket_status_history")
}

model TicketActivityLog {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  adminId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([action])
  @@map("ticket_activity_logs")
}

model TicketRating {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@map("ticket_ratings")
}

