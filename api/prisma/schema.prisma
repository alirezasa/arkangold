generator client {
 provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


////////////////////////////////////////////////////
//////////////////// ENUMS /////////////////////////
////////////////////////////////////////////////////

enum UserRole {
 USER
 ADMIN
 ACCOUNTANT
 SUPPORT
}

enum UserStatus {
 ACTIVE
 SUSPENDED
 BLOCKED
}

enum OtpType {
 LOGIN
 REGISTER
 VERIFY
}

enum SessionStatus {
 ACTIVE
 REVOKED
 EXPIRED
}

enum KycStatus {
 PENDING
 VERIFIED
 REJECTED
 FAILED
}
enum RegistrationStep {
  OTP_VERIFIED
  PASSWORD_SET
  PROFILE_COMPLETED
  KYC_VERIFIED
}


enum WalletCurrency {
 TOMAN
 GOLD
}

enum AccountGroup {
 ASSET
 LIABILITY
 REVENUE
 EXPENSE
}

enum OwnerType {
 USER
 SYSTEM
}

enum EntryType {
 DEBIT
 CREDIT
}

enum OrderType {
 BUY
 SELL
}

enum OrderStatus {
 PENDING
 PENDING_APPROVAL
 COMPLETED
 REJECTED
 CANCELLED
}

enum WithdrawalStatus {
 PENDING
 APPROVED
 PROCESSING
 PAID
 REJECTED
}

enum PriceLockStatus {
 ACTIVE
 USED
 EXPIRED
}

enum ProductType {
 DIGITAL_GOLD
 PHYSICAL_GOLD
}

enum FinancialRequestStatus {
 PENDING
 APPROVED
 REJECTED
 COMPLETED
}

enum ApprovalStatus {
 PENDING
 APPROVED
 REJECTED
}

////////////////////////////////////////////////////
//////////////////// USERS /////////////////////////
////////////////////////////////////////////////////

model User {
 id               String   @id @default(uuid())
 mobile           String   @unique
 email            String?
 passwordHash     String?

 role             UserRole   @default(USER)
 status           UserStatus @default(ACTIVE)
 registrationStep RegistrationStep @default(OTP_VERIFIED)

 isMobileVerified Boolean @default(false)
 twoFactorEnabled Boolean @default(false)

 createdAt        DateTime @default(now())
 updatedAt        DateTime @updatedAt

 wallet           Wallet?
 identity         UserIdentity?

 sessions         UserSession[]
 otps             UserOtp[]

 accounts         Account[]
 orders           Order[]
 withdrawals      Withdrawal[]
 priceLocks       PriceLock[]
 financialRequests FinancialRequest[]

 auditLogs        AuditLog[]
 walletHolds WalletHold[]


 @@index([mobile])
}

////////////////////////////////////////////////////
//////////////////// AUTH //////////////////////////
////////////////////////////////////////////////////

model UserOtp {
 id        String @id @default(uuid())

 userId    String?
 mobile    String

 code      String
 type      OtpType

 attempts  Int      @default(0)

 expiresAt DateTime
 used      Boolean @default(false)

 createdAt DateTime @default(now())

 user User? @relation(fields: [userId], references: [id])

 @@index([mobile])
 @@index([mobile, type])    
}

model UserSession {
 id        String @id @default(uuid())

 userId    String

 tokenHash String   @unique 

 status    SessionStatus @default(ACTIVE)
device    String?
  ip        String?
 ipAddress String?
 userAgent String?

 expiresAt DateTime

 createdAt DateTime @default(now())

 user User @relation(fields: [userId], references: [id])

 @@index([userId])
 @@index([tokenHash])
}

////////////////////////////////////////////////////
//////////////////// KYC ///////////////////////////
////////////////////////////////////////////////////

model UserIdentity {
 id String @id @default(uuid())

 userId String @unique

 nationalCode String

 firstName String
 lastName  String

 birthDate DateTime?

 status KycStatus @default(PENDING)

 verifiedAt DateTime?

 createdAt DateTime @default(now())

 user User @relation(fields: [userId], references: [id])
}

////////////////////////////////////////////////////
//////////////////// WALLET ////////////////////////
////////////////////////////////////////////////////

model Wallet {
 id String @id @default(uuid())

 userId String @unique

 tomanBalance Decimal @default(0) @db.Decimal(65,2)
 goldBalance  Decimal @default(0) @db.Decimal(65,6)

 lockedToman Decimal @default(0) @db.Decimal(65,2)
 lockedGold  Decimal @default(0) @db.Decimal(65,6)

 updatedAt DateTime @updatedAt

 user User @relation(fields: [userId], references: [id])

 holds WalletHold[]
}

model WalletHold {
 id String @id @default(uuid())

 userId String
 walletId String?  // این فیلد را اضافه کنید
 

 amount Decimal @db.Decimal(65,2)

 holdUntil DateTime

 reason String?

 createdAt DateTime @default(now())

 user   User   @relation(fields: [userId], references: [id])
 wallet   Wallet?  @relation(fields: [walletId], references: [id])  // این خط را اضافه کنید
 @@index([userId])
 @@index([walletId])
}

////////////////////////////////////////////////////
//////////////// CHART OF ACCOUNTS /////////////////
////////////////////////////////////////////////////

model Account {
 id String @id @default(uuid())

 code String @unique

 name String

 accountGroup AccountGroup

 ownerType OwnerType

 currency WalletCurrency

 userId String?

 createdAt DateTime @default(now())

 user User? @relation(fields: [userId], references: [id])

 ledgerEntries LedgerEntry[]

 @@index([userId])
}

////////////////////////////////////////////////////
//////////////////// LEDGER ////////////////////////
////////////////////////////////////////////////////

model JournalEntry {
 id String @id @default(uuid())

 referenceType String?
 referenceId String?

 description String?

 createdAt DateTime @default(now())

 entries LedgerEntry[]

 @@index([referenceId])
}

model LedgerEntry {
 id String @id @default(uuid())

 journalId String
 accountId String

 entryType EntryType

 amount Decimal @db.Decimal(65,6)

 createdAt DateTime @default(now())

 journal JournalEntry @relation(fields: [journalId], references: [id])
 account Account @relation(fields: [accountId], references: [id])

 @@index([journalId])
 @@index([accountId])
 @@index([createdAt])
}

////////////////////////////////////////////////////
//////////////// MARKET PRICE //////////////////////
////////////////////////////////////////////////////

model MarketPrice {
 asset String @id

 price Decimal @db.Decimal(65,2)

 updatedAt DateTime
}

model PriceHistory {
 id String @id @default(uuid())

 asset String

 price Decimal @db.Decimal(65,2)

 source String?

 createdAt DateTime @default(now())

 @@index([asset])
 @@index([createdAt])
}

////////////////////////////////////////////////////
//////////////// PRICE LOCK ////////////////////////
////////////////////////////////////////////////////

model PriceLock {
 id String @id @default(uuid())

 userId String

 asset String

 weight Decimal @db.Decimal(65,6)

 lockedPrice Decimal @db.Decimal(65,2)

 expiresAt DateTime

 status PriceLockStatus @default(ACTIVE)

 createdAt DateTime @default(now())

 user User @relation(fields: [userId], references: [id])

 order Order?

 @@index([userId])
}


////////////////////////////////////////////////////
//////////////// PRODUCTS //////////////////////////
////////////////////////////////////////////////////

model ProductCategory {
 id String @id @default(uuid())

 name String

 createdAt DateTime @default(now())

 products Product[]
}

model Product {
 id String @id @default(uuid())

 categoryId String

 name String

 type ProductType

 weight Decimal @db.Decimal(65,6)

 makingFeePercent Decimal @db.Decimal(65,4)

 isActive Boolean @default(true)

 createdAt DateTime @default(now())

 category ProductCategory @relation(fields: [categoryId], references: [id])

 orders Order[]
}

////////////////////////////////////////////////////
//////////////// ORDERS ////////////////////////////
////////////////////////////////////////////////////

model Order {
 id String @id @default(uuid())

 userId String
 productId String?

 type OrderType

 status OrderStatus @default(PENDING)

 weight Decimal @db.Decimal(65,6)

 pricePerGram Decimal @db.Decimal(65,2)

 totalAmount Decimal @db.Decimal(65,2)

 feeAmount Decimal @db.Decimal(65,2)

 taxAmount Decimal @db.Decimal(65,2)

 priceLockId String? @unique

 priceLock PriceLock? @relation(fields: [priceLockId], references: [id])

 createdAt DateTime @default(now())

 user User @relation(fields: [userId], references: [id])
 product Product? @relation(fields: [productId], references: [id])

 @@index([userId])
}


////////////////////////////////////////////////////
//////////////// WITHDRAWALS ///////////////////////
////////////////////////////////////////////////////

model Withdrawal {
 id String @id @default(uuid())

 userId String

 amount Decimal @db.Decimal(65,2)

 bankAccountId String?

 status WithdrawalStatus @default(PENDING)

 createdAt DateTime @default(now())

 user User @relation(fields: [userId], references: [id])

 @@index([userId])
}

////////////////////////////////////////////////////
////////////// FINANCIAL REQUESTS //////////////////
////////////////////////////////////////////////////

model FinancialRequest {
 id String @id @default(uuid())

 userId String

 requestType String

 referenceId String?

 status FinancialRequestStatus @default(PENDING)

 approvedBy String?

 approvedAt DateTime?

 createdAt DateTime @default(now())

 user User @relation(fields: [userId], references: [id])

 approvals Approval[]
}

////////////////////////////////////////////////////
//////////////// APPROVALS /////////////////////////
////////////////////////////////////////////////////

model Approval {
 id String @id @default(uuid())

 requestId String

 approverId String

 role String

status ApprovalStatus @default(PENDING)


 comment String?

 createdAt DateTime @default(now())

 request FinancialRequest @relation(fields: [requestId], references: [id])

 @@index([requestId])
}

////////////////////////////////////////////////////
//////////////////// LIMITS ////////////////////////
////////////////////////////////////////////////////

model UserLimit {
 id String @id @default(uuid())

 userId String

 dailyWithdrawLimit Decimal @db.Decimal(65,2)

 dailyBuyLimit Decimal @db.Decimal(65,2)

 maxOrderAmount Decimal @db.Decimal(65,2)

 createdAt DateTime @default(now())

 @@index([userId])
}

////////////////////////////////////////////////////
//////////////////// FEES //////////////////////////
////////////////////////////////////////////////////

model FeeConfig {
 id String @id @default(uuid())

 operationType String

 percent Decimal @db.Decimal(65,4)

 fixedAmount Decimal @db.Decimal(65,2)

 createdAt DateTime @default(now())
}

////////////////////////////////////////////////////
//////////////////// TAXES /////////////////////////
////////////////////////////////////////////////////

model TaxConfig {
 id String @id @default(uuid())

 name String

 percent Decimal @db.Decimal(65,4)

 isActive Boolean @default(true)

 createdAt DateTime @default(now())
}

////////////////////////////////////////////////////
//////////////////// AUDIT LOG /////////////////////
////////////////////////////////////////////////////

model AuditLog {
 id String @id @default(uuid())

 userId String?
 user   User?   @relation(fields: [userId], references: [id])  // این خط را اضافه کنید

 action String

 metadata Json?

 ipAddress String?

 createdAt DateTime @default(now())

 @@index([userId])
}

////////////////////////////////////////////////////
//////////////// SYSTEM CONFIG /////////////////////
////////////////////////////////////////////////////

model SystemConfig {
 key String @id

 value String

 description String?
}

////////////////////////////////////////////////////
/////////////// SETTLEMENT ENGINE //////////////////
////////////////////////////////////////////////////

model VaultGoldInventory {
 id String @id @default(uuid())

 totalGold Decimal @db.Decimal(65,6)

 reservedGold Decimal @db.Decimal(65,6)

 updatedAt DateTime @default(now())
}

model SettlementLog {
 id String @id @default(uuid())

 expectedGold Decimal @db.Decimal(65,6)

 actualGold Decimal @db.Decimal(65,6)

 difference Decimal @db.Decimal(65,6)

 createdAt DateTime @default(now())
}
