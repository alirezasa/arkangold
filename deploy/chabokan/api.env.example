# ─────────────────────────────────────────────────────────────
# متغیرهای محیطی سرویس API (api.arkan.gold) در چابکان
# این فایل فقط الگوست؛ مقادیر واقعی را در بخش «متغیرهای محیطی» سرویس در پنل چابکان وارد کنید.
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# اعمال خودکار migrationهای Prisma در هر بار اجرا (پیشنهادی: true)
RUN_MIGRATIONS=true

# ── پایگاه داده (سرویس PostgreSQL چابکان — آدرس داخلی شبکه) ──
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/arkangold

# ── Redis (سرویس Redis چابکان) ──
REDIS_HOST=REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=

# ── کلیدهای JWT — هر کدام مستقل و حداقل ۳۲ بایت؛ تولید: openssl rand -base64 48 ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_TEMP_SECRET=
JWT_RESET_SECRET=
JWT_ADMIN_SECRET=
JWT_ADMIN_REFRESH_SECRET=

# ── رمزنگاری Credential سرویس‌های خارجی — دقیقاً ۳۲ بایت base64؛ تولید: openssl rand -base64 32 ──
INTEGRATION_ENCRYPTION_KEY=

# ── فضای ذخیره‌سازی S3 (رسید واریز، پیوست تیکت) — Object Storage چابکان یا هر سرویس S3 سازگار ──
S3_ENDPOINT=https://
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── آدرس‌ها ──
# بازگشت کاربر پس از پرداخت درگاه
NEXT_PUBLIC_APP_URL=https://app.arkan.gold
# دامنه‌های اضافه‌ی CORS (جدا شده با کاما) — arkan.gold/app/admin به‌صورت پیش‌فرض مجازند
CORS_EXTRA_ORIGINS=

# ── لاگ ──
LOG_LEVEL=info
# هرگز در production فعال نشود
OTP_DEBUG_LOG=false
