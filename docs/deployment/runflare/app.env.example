# ── سرویس arkan-app در رانفلر (app.arkan.gold) ──────────────────────
APP_SERVICE=app
NODE_ENV=production
PORT=3000

# سمت سرور: آدرسی که سرور Next.js با آن به API وصل می‌شود. اگر رانفلر برای سرویس arkan-api آدرس
# داخلی (شبکه‌ی داخلی پروژه) نشان می‌دهد، همان را با پورت 3000 بگذارید (سریع‌تر و بدون عبور از اینترنت)؛
# وگرنه آدرس عمومی API:
NEST_API_URL=https://api.arkan.gold
NEST_ORIGIN=https://api.arkan.gold
API_BASE_URL=https://api.arkan.gold

# سمت مرورگر: آدرس عمومی API
NEXT_PUBLIC_NEST_ORIGIN=https://api.arkan.gold
NEXT_PUBLIC_API_URL=https://api.arkan.gold/auth

# همان مقدار INTERNAL_PROXY_SECRET برنامه‌ی API (برای ارسال IP واقعی کاربر به API)
INTERNAL_PROXY_SECRET=

# پشت CDN آروان: همان مقدار CDN_PROXY_RANGES برنامه‌ی API (رنج‌های https://www.arvancloud.ir/fa/ips.txt)
# فهرست آروان در تاریخ ۱۴۰۵/۰۷/۰۶ (۲۰۲۶-۰۹-۲۸):
CDN_PROXY_RANGES=185.143.232.0/22,188.229.116.16/30,94.101.182.0/27,2.144.3.128/28,37.32.16.0/27,37.32.17.0/27,37.32.18.0/27,37.32.19.0/27,185.215.232.0/22,178.131.120.48/28,94.101.183.0/28,78.157.36.112/28,95.38.61.80/28,193.24.119.0/29
