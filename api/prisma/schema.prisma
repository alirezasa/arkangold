  trackingCode      String?                  @map("tracking_code")
  estimatedDelivery DateTime?                @map("estimated_delivery")
  deliveredAt       DateTime?                @map("delivered_at")
  status            ShippingStatus           @default(IN_TRANSIT)
  createdAt         DateTime                 @default(now()) @map("created_at")
  id                String                   @id @default(uuid()) @db.Uuid
  deliveryRequestId String?                  @map("delivery_request_id") @db.Uuid
  shopOrderId       String?                  @map("shop_order_id") @db.Uuid
  deliveryRequest   PhysicalDeliveryRequest? @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)
  shopOrder         ShopOrder?               @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)

  @@map("shippings")
}

model PayrollPlan {
  name         String
  amountGrams  Decimal           @map("amount_grams") @db.Decimal(18, 4)
  executionDay Int               @map("execution_day")
  isActive     Boolean           @default(true) @map("is_active")
  startDate    DateTime?         @map("start_date")
  endDate      DateTime?         @map("end_date")
  createdAt    DateTime          @default(now()) @map("created_at")
  id           String            @id @default(uuid()) @db.Uuid
  createdById  String            @map("created_by_id") @db.Uuid
  logs         PayrollLog[]
  users        PayrollPlanUser[]
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("payroll_plans")
}

model PayrollPlanUser {
  id     String      @id @default(uuid()) @db.Uuid
  planId String      @map("plan_id") @db.Uuid
  userId String      @map("user_id") @db.Uuid
  plan   PayrollPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@map("payroll_plan_users")
}

model PayrollLog {
  executionDate DateTime      @map("execution_date")
  status        PayrollStatus
  totalUsers    Int           @map("total_users")
  successful    Int
  failed        Int
  details       Json?
  startedAt     DateTime      @map("started_at")
  finishedAt    DateTime?     @map("finished_at")
  id            String        @id @default(uuid()) @db.Uuid
  planId        String        @map("plan_id") @db.Uuid
  plan          PayrollPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("payroll_logs")
}

model AuditLog {
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
