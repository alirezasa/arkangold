# ── سرویس api.arkan.gold (NestJS) ─────────────────────────────────────
# این فایل را کامل کنید و در چابکان: تنظیمات سرویس ← متغیرهای محیطی ← «آپلود فایل .env»
APP_SERVICE=api
NODE_ENV=production
PORT=3000

# PostgreSQL چابکان (اتصال مستقیم) — یا آدرس prisma+postgres:// اگر همچنان از Prisma Accelerate استفاده می‌کنید
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Redis چابکان
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# هر کدام یک کلید مستقل و حداقل ۳۲ بایتی: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_TEMP_SECRET=
JWT_RESET_SECRET=
JWT_ADMIN_SECRET=
JWT_ADMIN_REFRESH_SECRET=

# کلید رمزنگاری اطلاعات اتصال سرویس‌های بیرونی: openssl rand -base64 32
# (اگر دیتابیس قبلی را منتقل می‌کنید، همان کلید قبلی را بگذارید)
INTEGRATION_ENCRYPTION_KEY=

# فضای ذخیره‌سازی S3 (مثلاً MinIO چابکان) — برای رسید واریز و پیوست تیکت
S3_ENDPOINT=https://
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# آدرس فرانت کاربر برای بازگشت از درگاه پرداخت
NEXT_PUBLIC_APP_URL=https://app.arkan.gold

# اجرای خودکار `prisma migrate deploy` پیش از هر start (برای غیرفعال‌سازی: false)
PRISMA_MIGRATE_ON_START=true
LOG_LEVEL=info
# دامنه‌های اضافه برای CORS (جدا شده با کاما)
# CORS_EXTRA_ORIGINS=

# راز مشترک با app و admin (هر سه برنامه دقیقاً همین مقدار): با آن API، IP و User-Agent واقعی
# کاربر را از درخواست‌های سرور Next.js می‌پذیرد تا rate limit برای هر کاربر جدا حساب شود.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
INTERNAL_PROXY_SECRET=

# پراکسی‌های مورد اعتماد برای خواندن IP کاربر از X-Forwarded-For (پیش‌فرض: شبکه‌ی داخلی پلتفرم).
# فقط اگر پشت CDN (مثل Cloudflare/آروان) هستید رنج‌های آن را اضافه کنید.
# TRUST_PROXY=loopback, linklocal, uniquelocal, 100.64.0.0/10
