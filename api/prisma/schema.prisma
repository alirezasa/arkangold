  province             String?
  city                 String?
  postalCode           String?                   @map("postal_code")
  fullAddress          String                    @map("full_address")
  receiverName         String?                   @map("receiver_name")
  receiverPhone        String?                   @map("receiver_phone")
  isDefault            Boolean                   @default(false) @map("is_default")
  createdAt            DateTime                  @default(now()) @map("created_at")
  id                   String                    @id @default(uuid()) @db.Uuid
  userId               String                    @map("user_id") @db.Uuid
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  physicalDeliveryReqs PhysicalDeliveryRequest[] // ← این خط
  shopOrders           ShopOrder[] // ← این خط

  @@index([userId])
  @@map("addresses")
}

model PhysicalDeliveryRequest {
  amountGrams  Decimal                @map("amount_grams") @db.Decimal(18, 4)
  feeRial      Decimal                @default(0) @map("fee_rial") @db.Decimal(18, 0)
  status       PhysicalDeliveryStatus @default(PENDING)
  trackingCode String?                @map("tracking_code")
  adminNotes   String?                @map("admin_notes")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  addressId    String                 @map("address_id") @db.Uuid
  approvedById String?                @map("approved_by_id") @db.Uuid
