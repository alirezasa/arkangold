# ── برنامه‌ی arkan-app در لیارا (app.arkan.gold) ──────────────────────
APP_SERVICE=app
NODE_ENV=production
PORT=3000

# سمت سرور: اتصال مستقیم به API از شبکه‌ی خصوصی لیارا (arkan-api = شناسه‌ی برنامه‌ی API)
NEST_API_URL=http://arkan-api:3000
NEST_ORIGIN=http://arkan-api:3000
API_BASE_URL=http://arkan-api:3000

# سمت مرورگر: آدرس عمومی API
NEXT_PUBLIC_NEST_ORIGIN=https://api.arkan.gold
NEXT_PUBLIC_API_URL=https://api.arkan.gold/auth

# همان مقدار INTERNAL_PROXY_SECRET برنامه‌ی API (برای ارسال IP واقعی کاربر به API)
INTERNAL_PROXY_SECRET=
