generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  mobile            String             @unique
  email             String?
  passwordHash      String?
  role              UserRole           @default(USER)
  status            UserStatus         @default(ACTIVE)
  isMobileVerified  Boolean            @default(false)
  twoFactorEnabled  Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  registrationStep  RegistrationStep   @default(OTP_VERIFIED)
  accounts          Account[]
  auditLogs         AuditLog[]
  financialRequests FinancialRequest[]
  orders            Order[]
  priceLocks        PriceLock[]
  identity          UserIdentity?
  otps              UserOtp[]
  sessions          UserSession[]
  wallet            Wallet?
  walletHolds       WalletHold[]
  withdrawals       Withdrawal[]

  @@index([mobile])
}

model UserOtp {
  id        String   @id @default(uuid())
  userId    String?  // اگر کاربر از قبل وجود دارد
  mobile    String
  code      String   // هش شده OTP
  type      OtpType  // LOGIN, REGISTER, RESET
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  sentAt    DateTime? // زمان ارسال واقعی پیامک
  verifiedAt DateTime? // زمان تایید موفق
  failedReason String? // دلیل ناموفق بودن (مثل: expired, wrong_code)
  ip        String?  // IP کاربر در زمان درخواست
  device    String?  // اطلاعات دستگاه کاربر

  user      User?    @relation(fields: [userId], references: [id])

  @@index([mobile])
  @@index([mobile, type])
}


model UserSession {
  id        String        @id @default(uuid())
  userId    String
  status    SessionStatus @default(ACTIVE)
  ipAddress String?       // ← فقط این یک فیلد برای IP
  device    String?       // ← دستگاهی که سشن از آن ایجاد شده
  expiresAt DateTime
  createdAt DateTime      @default(now())
  tokenHash String        @unique
  user      User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
}

model UserIdentity {
  id           String    @id @default(uuid())
  userId       String    @unique
  nationalCode String
  firstName    String
  lastName     String
  birthDate    DateTime?
  status       KycStatus @default(PENDING)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])
}

model Wallet {
  id           String       @id @default(uuid())
  userId       String       @unique
  tomanBalance Decimal      @default(0) @db.Decimal(65, 2)
  goldBalance  Decimal      @default(0) @db.Decimal(65, 6)
  lockedToman  Decimal      @default(0) @db.Decimal(65, 2)
  lockedGold   Decimal      @default(0) @db.Decimal(65, 6)
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id])
  holds        WalletHold[]
}

model WalletHold {
  id        String   @id @default(uuid())
  userId    String
  walletId  String?
  amount    Decimal  @db.Decimal(65, 2)
  holdUntil DateTime
  reason    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  wallet    Wallet?  @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([walletId])
}

model Account {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  accountGroup  AccountGroup
  ownerType     OwnerType
  currency      WalletCurrency
  userId        String?
  createdAt     DateTime       @default(now())
  user          User?          @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([userId])
}

model JournalEntry {
  id            String        @id @default(uuid())
  referenceType String?
  referenceId   String?
  description   String?
  createdAt     DateTime      @default(now())
  entries       LedgerEntry[]

  @@index([referenceId])
}

model LedgerEntry {
  id        String       @id @default(uuid())
  journalId String
  accountId String
  entryType EntryType
  amount    Decimal      @db.Decimal(65, 6)
  createdAt DateTime     @default(now())
  account   Account      @relation(fields: [accountId], references: [id])
  journal   JournalEntry @relation(fields: [journalId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@index([createdAt])
}

model MarketPrice {
  asset     String   @id
  price     Decimal  @db.Decimal(65, 2)
  updatedAt DateTime
}

model PriceHistory {
  id        String   @id @default(uuid())
  asset     String
  price     Decimal  @db.Decimal(65, 2)
  source    String?
  createdAt DateTime @default(now())

  @@index([asset])
  @@index([createdAt])
}

model PriceLock {
  id          String          @id @default(uuid())
  userId      String
  asset       String
  weight      Decimal         @db.Decimal(65, 6)
  lockedPrice Decimal         @db.Decimal(65, 2)
  expiresAt   DateTime
  status      PriceLockStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  order       Order?
  user        User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id               String          @id @default(uuid())
  categoryId       String
  name             String
  type             ProductType
  weight           Decimal         @db.Decimal(65, 6)
  makingFeePercent Decimal         @db.Decimal(65, 4)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  orders           Order[]
  category         ProductCategory @relation(fields: [categoryId], references: [id])
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  productId    String?
  type         OrderType
  status       OrderStatus @default(PENDING)
  weight       Decimal     @db.Decimal(65, 6)
  pricePerGram Decimal     @db.Decimal(65, 2)
  totalAmount  Decimal     @db.Decimal(65, 2)
  feeAmount    Decimal     @db.Decimal(65, 2)
  taxAmount    Decimal     @db.Decimal(65, 2)
  priceLockId  String?     @unique
  createdAt    DateTime    @default(now())
  priceLock    PriceLock?  @relation(fields: [priceLockId], references: [id])
  product      Product?    @relation(fields: [productId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Withdrawal {
  id            String           @id @default(uuid())
  userId        String
  amount        Decimal          @db.Decimal(65, 2)
  bankAccountId String?
  status        WithdrawalStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

model FinancialRequest {
  id          String                 @id @default(uuid())
  userId      String
  requestType String
  referenceId String?
  status      FinancialRequestStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime               @default(now())
  approvals   Approval[]
  user        User                   @relation(fields: [userId], references: [id])
}

model Approval {
  id         String           @id @default(uuid())
  requestId  String
  approverId String
  role       String
  status     ApprovalStatus   @default(PENDING)
  comment    String?
  createdAt  DateTime         @default(now())
  request    FinancialRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
}

model UserLimit {
  id                 String   @id @default(uuid())
  userId             String
  dailyWithdrawLimit Decimal  @db.Decimal(65, 2)
  dailyBuyLimit      Decimal  @db.Decimal(65, 2)
  maxOrderAmount     Decimal  @db.Decimal(65, 2)
  createdAt          DateTime @default(now())

  @@index([userId])
}

model FeeConfig {
  id            String   @id @default(uuid())
  operationType String
  percent       Decimal  @db.Decimal(65, 4)
  fixedAmount   Decimal  @db.Decimal(65, 2)
  createdAt     DateTime @default(now())
}

model TaxConfig {
  id        String   @id @default(uuid())
  name      String
  percent   Decimal  @db.Decimal(65, 4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SystemConfig {
  key         String  @id
  value       String
  description String?
}

model VaultGoldInventory {
  id           String   @id @default(uuid())
  totalGold    Decimal  @db.Decimal(65, 6)
  reservedGold Decimal  @db.Decimal(65, 6)
  updatedAt    DateTime @default(now())
}

model SettlementLog {
  id           String   @id @default(uuid())
  expectedGold Decimal  @db.Decimal(65, 6)
  actualGold   Decimal  @db.Decimal(65, 6)
  difference   Decimal  @db.Decimal(65, 6)
  createdAt    DateTime @default(now())
}

enum UserRole {
  USER
  ADMIN
  ACCOUNTANT
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum OtpType {
  LOGIN
  REGISTER
  VERIFY
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  FAILED
}

enum RegistrationStep {
  OTP_VERIFIED
  PASSWORD_SET
  PROFILE_COMPLETED
  KYC_VERIFIED
}

enum WalletCurrency {
  TOMAN
  GOLD
}

enum AccountGroup {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
}

enum OwnerType {
  USER
  SYSTEM
}

enum EntryType {
  DEBIT
  CREDIT
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  PENDING_APPROVAL
  COMPLETED
  REJECTED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum PriceLockStatus {
  ACTIVE
  USED
  EXPIRED
}

enum ProductType {
  DIGITAL_GOLD
  PHYSICAL_GOLD
}

enum FinancialRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
