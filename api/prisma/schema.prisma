generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  phone                String                    @unique
  passwordHash         String?                   @map("password_hash")
  type                 UserType                  @default(REAL)
  status               UserStatus                @default(ACTIVE)
  referralCode         String                    @unique @map("referral_code")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  id                   String                    @id @default(uuid()) @db.Uuid
  referredById         String?                   @map("referred_by_id") @db.Uuid
  addresses            Address[]
  approvals            Approval[]
  adminAuditLogs       AuditLog[]                @relation("AdminAudit")
  auditLogs            AuditLog[]                @relation("UserAudit")
  bankAccounts         BankAccount[]
  cart                 Cart?
  feeConfigs           FeeConfig[]
  legalProfile         LegalProfile?
  notifications        Notification[]
  orders               Order[]
  payments             Payment[]
  payrollPlanUsers     PayrollPlanUser[]
  createdPayrollPlans  PayrollPlan[]
  approvedByPhysical   PhysicalDeliveryRequest[] @relation("ApprovedBy")
  physicalDeliveryReqs PhysicalDeliveryRequest[]
  priceLocks           PriceLock[]
  referralRewards      ReferralReward[]
  receivedReferrals    Referral?                 @relation("Referred")
  sentReferrals        Referral[]                @relation("Referrer")
  settlementLogs       SettlementLog[]
  shopOrders           ShopOrder[]
  taxConfigs           TaxConfig[]
  transactions         Transaction[]
  identity             UserIdentity?
  limits               UserLimit?
  sessions             UserSession[]
  referredBy           User?                     @relation("Referral", fields: [referredById], references: [id])
  referrals            User[]                    @relation("Referral")
  wallet               Wallet?
  processedWithdrawals WithdrawalRequest[]       @relation("ProcessedBy")
  withdrawalRequests   WithdrawalRequest[]

  @@map("users")
}

model UserOtp {
  phone     String
  codeHash  String     @map("code_hash")
  attempts  Int        @default(0)
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")
  id        String     @id @default(uuid()) @db.Uuid

  @@index([phone, purpose])
  @@map("user_otps")
}

model UserSession {
  device           String?
  ip               String?
  refreshTokenHash String   @map("refresh_token_hash")
  accessTokenHash  String?  @map("access_token_hash")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model UserIdentity {
  firstName     String?        @map("first_name")
  lastName      String?        @map("last_name")
  nationalCode  String?        @unique @map("national_code")
  birthDate     DateTime?      @map("birth_date")
  status        IdentityStatus @default(PENDING)
  verifiedAt    DateTime?      @map("verified_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @unique @map("user_id") @db.Uuid
  legalProfiles LegalProfile[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_identities")
}


model LegalProfile {
  companyName        String              @map("company_name")
  nationalId         String              @unique @map("national_id")
  economicCode       String?             @map("economic_code")
  registrationNumber String?             @map("registration_number")
  verified           Boolean             @default(false)
  status             LegalProfileStatus  @default(PENDING)
  rejectionReason    String?             @map("rejection_reason")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  representativeId   String?             @map("representative_id") @db.Uuid
  representative     UserIdentity?       @relation(fields: [representativeId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          LegalProfileDocument[]

  @@map("legal_profiles")
}

model LegalProfileDocument {
  id             String       @id @default(uuid()) @db.Uuid
  legalProfileId String       @map("legal_profile_id") @db.Uuid
  legalProfile   LegalProfile @relation(fields: [legalProfileId], references: [id], onDelete: Cascade)
  type           String       // INTRODUCTION_LETTER | ARTICLES_OF_ASSOCIATION | OTHER
  fileName       String       @map("file_name")
  filePath       String       @map("file_path")
  fileSize       Int          @map("file_size")
  mimeType       String       @map("mime_type")
  uploadedAt     DateTime     @default(now()) @map("uploaded_at")

  @@index([legalProfileId])
  @@map("legal_profile_documents")
}

model BankAccount {
  bankName           String              @map("bank_name")
  accountNumber      String              @map("account_number")
  cardNumber         String              @map("card_number")
  sheba              String?
  isVerified         Boolean             @default(false) @map("is_verified")
  isDefault          Boolean             @default(false) @map("is_default")
  createdAt          DateTime            @default(now()) @map("created_at")
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequests WithdrawalRequest[]

  @@index([userId])
  @@map("bank_accounts")
}

model Wallet {
  goldBalanceGrams Decimal       @default(0) @map("gold_balance_grams") @db.Decimal(18, 4)
  rialBalance      Decimal       @default(0) @map("rial_balance") @db.Decimal(18, 0)
  cardNumber       String        @unique @map("card_number")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @unique @map("user_id") @db.Uuid
  transactions     Transaction[]
  holds            WalletHold[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletHold {
  amountGrams Decimal? @map("amount_grams") @db.Decimal(18, 4)
  amountRial  Decimal? @map("amount_rial") @db.Decimal(18, 0)
  holdType    HoldType @map("hold_type")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  id          String   @id @default(uuid()) @db.Uuid
  walletId    String   @map("wallet_id") @db.Uuid
  referenceId String?  @map("reference_id") @db.Uuid
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([expiresAt])
  @@map("wallet_holds")
}

model Transaction {
  type                 TransactionType
  amountGrams          Decimal?                 @db.Decimal(18, 4)
  amountRial           Decimal?                 @db.Decimal(18, 0)
  pricePerGram         Decimal?                 @map("price_per_gram") @db.Decimal(18, 0)
  feeAmount            Decimal?                 @map("fee_amount") @db.Decimal(18, 0)
  taxAmount            Decimal?                 @map("tax_amount") @db.Decimal(18, 0)
  status               TransactionStatus        @default(PENDING)
  description          String?
  createdAt            DateTime                 @default(now()) @map("created_at")
  physicalDeliveryId   String?                  @map("physical_delivery_id") @db.Uuid
  shopOrderId          String?                  @map("shop_order_id") @db.Uuid
  id                   String                   @id @default(uuid()) @db.Uuid
  userId               String                   @map("user_id") @db.Uuid
  walletId             String                   @map("wallet_id") @db.Uuid
  relatedTransactionId String?                  @map("related_transaction_id") @db.Uuid
  journalEntries       JournalEntry[]
  referralRewards      ReferralReward[]
  physicalDelivery     PhysicalDeliveryRequest? @relation(fields: [physicalDeliveryId], references: [id])
  relatedTransaction   Transaction?             @relation("RelatedTransaction", fields: [relatedTransactionId], references: [id])
  childTransactions    Transaction[]            @relation("RelatedTransaction")
  shopOrder            ShopOrder?               @relation(fields: [shopOrderId], references: [id])
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet               Wallet                   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([walletId])
  @@index([userId, type, status, createdAt])
  @@map("transactions")
}

model Account {
  code          String        @unique
  name          String
  type          AccountType
  subType       String?       @map("sub_type")
  balanceRial   Decimal       @default(0) @map("balance_rial") @db.Decimal(18, 0)
  balanceGrams  Decimal       @default(0) @map("balance_grams") @db.Decimal(18, 4)
  id            String        @id @default(uuid()) @db.Uuid
  ledgerEntries LedgerEntry[]

  @@map("accounts")
}

model JournalEntry {
  description   String?
  totalRial     Decimal       @default(0) @map("total_rial") @db.Decimal(18, 0)
  totalGrams    Decimal       @default(0) @map("total_grams") @db.Decimal(18, 4)
  entryDate     DateTime      @default(now()) @map("entry_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  id            String        @id @default(uuid()) @db.Uuid
  transactionId String?       @map("transaction_id") @db.Uuid
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  ledgerEntries LedgerEntry[]

  @@map("journal_entries")
}

model LedgerEntry {
  side           LedgerSide
  amountRial     Decimal      @default(0) @map("amount_rial") @db.Decimal(18, 0)
  amountGrams    Decimal      @default(0) @map("amount_grams") @db.Decimal(18, 4)
  createdAt      DateTime     @default(now()) @map("created_at")
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @map("journal_entry_id") @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("ledger_entries")
}

model MarketPrice {
  metal            MetalType @unique
  pricePerGramRial Decimal   @map("price_per_gram_rial") @db.Decimal(18, 0)
  source           String?
  fetchedAt        DateTime  @default(now()) @updatedAt @map("fetched_at")
  id               String    @id @default(uuid()) @db.Uuid

  @@map("market_prices")
}

model PriceHistory {
  metal            MetalType
  pricePerGramRial Decimal   @map("price_per_gram_rial") @db.Decimal(18, 0)
  recordedAt       DateTime  @default(now()) @map("recorded_at")
  id               String    @id @default(uuid()) @db.Uuid

  @@index([metal, recordedAt])
  @@map("price_history")
}

model PriceLock {
  metal       MetalType
  amountGrams Decimal   @map("amount_grams") @db.Decimal(18, 4)
  side        OrderSide
  lockedPrice Decimal   @map("locked_price") @db.Decimal(18, 0)
  expiresAt   DateTime  @map("expires_at")
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  feeRial     Decimal   @default(0) @map("fee_rial") @db.Decimal(18, 0)
  taxRial     Decimal   @default(0) @map("tax_rial") @db.Decimal(18, 0)
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  order       Order?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, used])
  @@index([used, expiresAt])
  @@map("price_locks")
}

model Order {
  metal        MetalType
  side         OrderSide
  amountGrams  Decimal     @map("amount_grams") @db.Decimal(18, 4)
  pricePerGram Decimal     @map("price_per_gram") @db.Decimal(18, 0)
  totalRial    Decimal     @map("total_rial") @db.Decimal(18, 0)
  fee          Decimal     @default(0) @db.Decimal(18, 0)
  tax          Decimal     @default(0) @db.Decimal(18, 0)
  status       OrderStatus @default(PENDING)
  completedAt  DateTime?   @map("completed_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  lockId       String?     @unique @map("lock_id") @db.Uuid
  lock         PriceLock?  @relation(fields: [lockId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("orders")
}

model ProductCategory {
  name        String
  slug        String            @unique
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  id          String            @id @default(uuid()) @db.Uuid
  parentId    String?           @map("parent_id") @db.Uuid
  parent      ProductCategory?  @relation("SubCategories", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("SubCategories")
  products    Product[]

  @@map("product_categories")
}

model Product {
  name          String
  slug          String           @unique
  description   String?
  basePriceRial Decimal          @map("base_price_rial") @db.Decimal(18, 0)
  status        ProductStatus    @default(ACTIVE)
  seoTitle      String?          @map("seo_title")
  seoDesc       String?          @map("seo_desc")
  pricingMode      ProductPricingMode @default(FIXED) @map("pricing_mode")
  minWeightGrams   Decimal?         @map("min_weight_grams") @db.Decimal(18, 4)
  maxWeightGrams   Decimal?         @map("max_weight_grams") @db.Decimal(18, 4)
  weightStepGrams  Decimal?         @default(0.1) @map("weight_step_grams") @db.Decimal(18, 4)
  pricePerGramRial Decimal?         @map("price_per_gram_rial") @db.Decimal(18, 0)

  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  id            String           @id @default(uuid()) @db.Uuid
  categoryId    String           @map("category_id") @db.Uuid
  variants      ProductVariant[]
  category      ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
   cartItems        CartItem[]        // ⬅️ جدید
  shopOrderItems   ShopOrderItem[]   // ⬅️ جدید
  images ProductImage[]   // ⬅️ جدید

  @@map("products")
}

model ProductVariant {
  weightGrams     Decimal         @map("weight_grams") @db.Decimal(18, 4)
  priceAdjustment Decimal         @default(0) @map("price_adjustment") @db.Decimal(18, 0)
  stockQuantity   Int             @default(0) @map("stock_quantity")
  sku             String?         @unique
  createdAt       DateTime        @default(now()) @map("created_at")
  id              String          @id @default(uuid()) @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  cartItems       CartItem[]
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopOrderItems  ShopOrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String   // مسیر عمومی مثل /uploads/products/xxx.webp
  altText    String?  @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

model Cart {
  createdAt DateTime   @default(now()) @map("created_at")
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  quantity            Int
  createdAt           DateTime        @default(now()) @map("created_at")
  id                  String          @id @default(uuid()) @db.Uuid
  cartId              String          @map("cart_id") @db.Uuid
  variantId           String?         @map("variant_id") @db.Uuid
  productId           String?         @map("product_id") @db.Uuid
  selectedWeightGrams Decimal?        @map("selected_weight_grams") @db.Decimal(18, 4)
  cart                Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model ShopOrder {
  status       ShopOrderStatus @default(PENDING_PAYMENT)
  totalRial    Decimal         @map("total_rial") @db.Decimal(18, 0)
  trackingCode String?         @map("tracking_code")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  addressId    String          @map("address_id") @db.Uuid
  payments     Payment[]
  items        ShopOrderItem[]
  address      Address         @relation(fields: [addressId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  shippings Shipping[]
  @@index([userId])
  @@map("shop_orders")
}

model ShopOrderItem {
  quantity            Int
  priceRial           Decimal         @map("price_rial") @db.Decimal(18, 0)
  selectedWeightGrams  Decimal?        @map("selected_weight_grams") @db.Decimal(18, 4)
  createdAt           DateTime        @default(now()) @map("created_at")
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  variantId           String?         @map("variant_id") @db.Uuid
  productId           String?         @map("product_id") @db.Uuid
  order               ShopOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("shop_order_items")
}

model Payment {
  amountRial    Decimal       @map("amount_rial") @db.Decimal(18, 0)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  referenceCode String?       @unique @map("reference_code")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  orderId       String?       @map("order_id") @db.Uuid
  order         ShopOrder?    @relation(fields: [orderId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model WithdrawalRequest {
  amountRial    Decimal          @map("amount_rial") @db.Decimal(18, 0)
  status        WithdrawalStatus @default(PENDING)
  adminNotes    String?          @map("admin_notes")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  bankAccountId String           @map("bank_account_id") @db.Uuid
  processedById String?          @map("processed_by_id") @db.Uuid
  approvals     Approval[]
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  processedBy   User?            @relation("ProcessedBy", fields: [processedById], references: [id])
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("withdrawal_requests")
}

model Approval {
  requestType               ApprovalType             @map("request_type")
  step                      Int                      @default(1)
  status                    ApprovalStatus
  comment                   String?
  createdAt                 DateTime                 @default(now()) @map("created_at")
  physicalDeliveryRequestId String?                  @map("physical_delivery_request_id") @db.Uuid
  withdrawalRequestId       String?                  @map("withdrawal_request_id") @db.Uuid
  id                        String                   @id @default(uuid()) @db.Uuid
  requestId                 String                   @map("request_id") @db.Uuid
  approverId                String                   @map("approver_id") @db.Uuid
  approver                  User                     @relation(fields: [approverId], references: [id], onDelete: Cascade)
  physicalDeliveryRequest   PhysicalDeliveryRequest? @relation(fields: [physicalDeliveryRequestId], references: [id], onDelete: Cascade)
  withdrawalRequest         WithdrawalRequest?       @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)

  @@index([requestType, requestId])
  @@map("approvals")
}

model UserLimit {
  dailyBuyLimitGrams       Decimal  @default(50) @map("daily_buy_limit_grams") @db.Decimal(18, 4)
  dailySellLimitGrams      Decimal  @default(50) @map("daily_sell_limit_grams") @db.Decimal(18, 4)
  monthlyWithdrawLimitRial Decimal  @default(500000000) @map("monthly_withdraw_limit_rial") @db.Decimal(18, 0)
  dailyTransferLimitGrams  Decimal  @default(100) @map("daily_transfer_limit_grams") @db.Decimal(18, 4)
  physicalDeliveryMinGrams Decimal  @default(1) @map("physical_delivery_min_grams") @db.Decimal(18, 4)
  physicalDeliveryMaxGrams Decimal  @default(500) @map("physical_delivery_max_grams") @db.Decimal(18, 4)
  updatedAt                DateTime @updatedAt @map("updated_at")
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @map("user_id") @db.Uuid
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_limits")
}

model FeeConfig {
  type         FeeType
  feePercent   Decimal  @map("fee_percent") @db.Decimal(5, 2)
  feeFixedRial Decimal? @map("fee_fixed_rial") @db.Decimal(18, 0)
  isActive     Boolean  @default(true) @map("is_active")
  updatedAt    DateTime @updatedAt @map("updated_at")
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, isActive])
  @@map("fee_configs")
}

model TaxConfig {
  type       TaxType
  taxPercent Decimal  @map("tax_percent") @db.Decimal(5, 2)
  isActive   Boolean  @default(true) @map("is_active")
  updatedAt  DateTime @updatedAt @map("updated_at")
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tax_configs")
}

model Referral {
  rewardClaimed Boolean          @default(false) @map("reward_claimed")
  createdAt     DateTime         @default(now()) @map("created_at")
  id            String           @id @default(uuid()) @db.Uuid
  referrerId    String           @map("referrer_id") @db.Uuid
  referredId    String           @unique @map("referred_id") @db.Uuid
  rewards       ReferralReward[]
  referred      User             @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  referrer      User             @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

model ReferralReward {
  amountGrams   Decimal?     @map("amount_grams") @db.Decimal(18, 4)
  amountRial    Decimal?     @map("amount_rial") @db.Decimal(18, 0)
  createdAt     DateTime     @default(now()) @map("created_at")
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  referralId    String       @map("referral_id") @db.Uuid
  transactionId String?      @map("transaction_id") @db.Uuid
  referral      Referral     @relation(fields: [referralId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_rewards")
}

model Address {
  title                String?
  province             String?
  city                 String?
  postalCode           String?                   @map("postal_code")
  fullAddress          String                    @map("full_address")
  receiverName         String?                   @map("receiver_name")
  receiverPhone        String?                   @map("receiver_phone")
  isDefault            Boolean                   @default(false) @map("is_default")
  createdAt            DateTime                  @default(now()) @map("created_at")
  id                   String                    @id @default(uuid()) @db.Uuid
  userId               String                    @map("user_id") @db.Uuid
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  physicalDeliveryReqs PhysicalDeliveryRequest[] // ← این خط
  shopOrders           ShopOrder[] // ← این خط

  @@index([userId])
  @@map("addresses")
}

model PhysicalDeliveryRequest {
  amountGrams  Decimal                @map("amount_grams") @db.Decimal(18, 4)
  feeRial      Decimal                @default(0) @map("fee_rial") @db.Decimal(18, 0)
  status       PhysicalDeliveryStatus @default(PENDING)
  trackingCode String?                @map("tracking_code")
  adminNotes   String?                @map("admin_notes")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  addressId    String                 @map("address_id") @db.Uuid
  approvedById String?                @map("approved_by_id") @db.Uuid
  approvals    Approval[]
  address      Address                @relation(fields: [addressId], references: [id], onDelete: Cascade)
  approvedBy   User?                  @relation("ApprovedBy", fields: [approvedById], references: [id])
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippings    Shipping[]
  transactions Transaction[]

  @@index([userId, status])
  @@map("physical_delivery_requests")
}

model Shipping {
  carrierName       String?                  @map("carrier_name")
  trackingCode      String?                  @map("tracking_code")
  estimatedDelivery DateTime?                @map("estimated_delivery")
  deliveredAt       DateTime?                @map("delivered_at")
  status            ShippingStatus           @default(IN_TRANSIT)
  createdAt         DateTime                 @default(now()) @map("created_at")
  id                String                   @id @default(uuid()) @db.Uuid
  deliveryRequestId String?                  @map("delivery_request_id") @db.Uuid
  shopOrderId       String?                  @map("shop_order_id") @db.Uuid
  deliveryRequest   PhysicalDeliveryRequest? @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)
  shopOrder         ShopOrder?               @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)

  @@map("shippings")
}


model PayrollPlan {
  name         String
  amountGrams  Decimal           @map("amount_grams") @db.Decimal(18, 4)
  executionDay Int               @map("execution_day")
  isActive     Boolean           @default(true) @map("is_active")
  startDate    DateTime?         @map("start_date")
  endDate      DateTime?         @map("end_date")
  createdAt    DateTime          @default(now()) @map("created_at")
  id           String            @id @default(uuid()) @db.Uuid
  createdById  String            @map("created_by_id") @db.Uuid
  logs         PayrollLog[]
  users        PayrollPlanUser[]
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("payroll_plans")
}

model PayrollPlanUser {
  id     String      @id @default(uuid()) @db.Uuid
  planId String      @map("plan_id") @db.Uuid
  userId String      @map("user_id") @db.Uuid
  plan   PayrollPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@map("payroll_plan_users")
}

model PayrollLog {
  executionDate DateTime      @map("execution_date")
  status        PayrollStatus
  totalUsers    Int           @map("total_users")
  successful    Int
  failed        Int
  details       Json?
  startedAt     DateTime      @map("started_at")
  finishedAt    DateTime?     @map("finished_at")
  id            String        @id @default(uuid()) @db.Uuid
  planId        String        @map("plan_id") @db.Uuid
  plan          PayrollPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("payroll_logs")
}

model AuditLog {
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  admin      User?    @relation("AdminAudit", fields: [adminId], references: [id])
  user       User?    @relation("UserAudit", fields: [userId], references: [id])

  @@index([userId])
  @@index([adminId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemConfig {
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  id          String   @id @default(uuid()) @db.Uuid

  @@map("system_configs")
}

model VaultGoldInventory {
  type        VaultInventoryType
  amountGrams Decimal            @map("amount_grams") @db.Decimal(18, 4)
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  id          String             @id @default(uuid()) @db.Uuid
  referenceId String?            @map("reference_id") @db.Uuid

  @@map("vault_gold_inventory")
}

model SettlementLog {
  bankTransactionId String           @unique @map("bank_transaction_id")
  amountRial        Decimal          @map("amount_rial") @db.Decimal(18, 0)
  status            SettlementStatus @default(PENDING)
  settledAt         DateTime?        @map("settled_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  id                String           @id @default(uuid()) @db.Uuid
  userId            String?          @map("user_id") @db.Uuid
  user              User?            @relation(fields: [userId], references: [id])

  @@map("settlement_logs")
}

model Notification {
  type      NotificationType
  content   String
  sentAt    DateTime?        @map("sent_at")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AdminUser {
  id                String    @id @default(uuid()) @db.Uuid
  username          String    @unique
  passwordHash      String    @map("password_hash")
  fullName          String    @map("full_name")
  isActive          Boolean   @default(true) @map("is_active")

  totpSecret        String?   @map("totp_secret")
  totpEnabled       Boolean   @default(false) @map("totp_enabled")
  totpEnabledAt     DateTime? @map("totp_enabled_at")
  backupCodesHash   String[]  @default([]) @map("backup_codes_hash")

  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginIp       String?   @map("last_login_ip")

  roleId            String    @map("role_id") @db.Uuid
  role              AdminRole @relation(fields: [roleId], references: [id])

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdById       String?   @map("created_by_id") @db.Uuid
  createdBy         AdminUser?  @relation("AdminCreatedBy", fields: [createdById], references: [id])
  createdAdmins     AdminUser[] @relation("AdminCreatedBy")

  sessions          AdminSession[]
  auditLogs         AdminAuditLog[]

  @@map("admin_users")
}

model AdminRole {
  id          String                @id @default(uuid()) @db.Uuid
  key         String                @unique
  name        String
  description String?
  isSystem    Boolean               @default(false) @map("is_system")
  permissions AdminRolePermission[]
  users       AdminUser[]
  createdAt   DateTime              @default(now()) @map("created_at")

  @@map("admin_roles")
}

model AdminPermission {
  id          String                @id @default(uuid()) @db.Uuid
  key         String                @unique
  group       String
  description String?
  roles       AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminSession {
  id               String     @id @default(uuid()) @db.Uuid
  adminUserId      String     @map("admin_user_id") @db.Uuid
  adminUser        AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String     @map("refresh_token_hash")
  ip               String?
  userAgent        String?    @map("user_agent")
  expiresAt        DateTime   @map("expires_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  @@index([adminUserId])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  oldValue    Json?     @map("old_value")
  newValue    Json?     @map("new_value")
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

